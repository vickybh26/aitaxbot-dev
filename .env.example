# ===========================================
# AiTaxBot Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ===========================================

# -----------------
# Server Configuration
# -----------------
PORT=5000
NODE_ENV=development

# -----------------
# Database (Required)
# -----------------
# PostgreSQL connection string from Neon or your database provider
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=your_postgresql_connection_string_here

# -----------------
# Zerodha Algo Trading (Required for /algo-trading page)
# -----------------
# Get these from https://developers.kite.trade/
# 1. Create a Kite Connect app
# 2. Set redirect URL to: https://your-domain.replit.app/algo-auth/
# 3. Copy API Key and API Secret
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here

# -----------------
# Google AI (Required for PDF Processing)
# -----------------
# Get from https://aistudio.google.com/apikey
# Used for Form 16, AIS, and 26AS document extraction
GOOGLE_API_KEY=your_google_gemini_api_key_here

# -----------------
# Adobe PDF Services (Optional)
# -----------------
# Get from https://developer.adobe.com/
# Used for advanced PDF processing features
ADOBE_CLIENT_ID=your_adobe_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_client_secret_here

# -----------------
# Market Data APIs (Optional - for enhanced features)
# -----------------
# Alpha Vantage - https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub - https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# News API - https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# SerpAPI (for Google News integration) - https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# ===========================================
# Firebase Configuration (Optional)
# ===========================================
# If using Firebase Storage for document storage:
# 1. Download your Firebase service account JSON
# 2. Save it as 'firebase-adminsdk-xxxxx.json' in project root
# 3. File will be auto-detected (already gitignored)

# ===========================================
# Replit-Specific (Auto-configured)
# ===========================================
# These are automatically set by Replit
# REPLIT_DOMAINS
# REPLIT_DEV_DOMAIN
# REPL_OWNER
# REPL_SLUG
