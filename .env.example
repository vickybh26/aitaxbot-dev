# ===========================================
# AiTaxBot Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ===========================================

# -----------------
# Server Configuration
# -----------------
PORT=5000
NODE_ENV=development

# -----------------
# Google AI (Required for PDF Processing)
# -----------------
# Get from https://aistudio.google.com/apikey
# Used for Form 16, AIS, and 26AS document extraction
GOOGLE_API_KEY=your_google_gemini_api_key_here

# -----------------
# Adobe PDF Services (Optional)
# -----------------
# Get from https://developer.adobe.com/
# Used for advanced PDF processing features
ADOBE_CLIENT_ID=your_adobe_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_client_secret_here

# -----------------
# Market Data APIs (Optional - for enhanced features)
# -----------------
# Alpha Vantage - https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub - https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# News API - https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# SerpAPI (for Google News integration) - https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# ===========================================
# Firebase Configuration (Required)
# ===========================================
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
# https://console.firebase.google.com/project/aitaxbot-e5c0e/settings/general

# --- Client-side (VITE_ prefix = exposed to browser) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=aitaxbot-e5c0e
VITE_FIREBASE_APP_ID=1:275518195519:web:00bbefb3e9f4c21470358a
VITE_FIREBASE_MESSAGING_SENDER_ID=275518195519
VITE_FIREBASE_DATABASE_URL=https://aitaxbot-e5c0e-default-rtdb.firebaseio.com
VITE_FIREBASE_MEASUREMENT_ID=G-WYGS15GW5J

# --- Server-side (Firebase Admin SDK) ---
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" → download JSON
# 3. Paste the ENTIRE JSON as a single-line string (minified) here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"aitaxbot-e5c0e",...}



# ── WhatsApp Bot (Meta Cloud API) ───────────────────────────────────────────
# Setup guide: server/whatsapp/SETUP.md
WHATSAPP_PHONE_NUMBER_ID=         # From Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=            # Permanent token from System User (Meta Business Suite)
WHATSAPP_VERIFY_TOKEN=aitaxbot_wh_verify_2026   # Any secret string you choose — used once during webhook setup
ADMIN_KEY=                        # Secret key to access /api/whatsapp/leads (choose any string)

# ── WhatsApp (Client/Frontend) ───────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=             # Your WhatsApp Business number e.g. 919876543210 (no + or spaces)
